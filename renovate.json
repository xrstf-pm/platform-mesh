{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "mergeConfidence:all-badges",
    "local>platform-mesh/.github:renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "OCM toolkit version",
      "managerFilePatterns": [
        "/(^|/)local-setup/kustomize/base/ocm-k8s-toolkit/ocm-k8s-toolkit\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*\"?(?<currentValue>[\\d\\.]+-?[\\w\\.-]*)\"?"
      ],
      "versioningTemplate": "semver",
      "depNameTemplate": "ghcr.io/open-component-model/kubernetes/controller/chart",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "OCM CLI version in the local-setup script",
      "managerFilePatterns": [
        "/(^|/)local-setup/scripts/ocm-setup\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*OCM_VERSION=\"\\$\\{OCM_VERSION:-(?<currentValue>[^}]+)\\}\""
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Allow pre-release updates for OCM component",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "**/ocm/component.yaml",
        "**/ocm-k8s-toolkit/ocm-k8s-toolkit.yaml"
      ],
      "ignoreUnstable": false
    }
  ]
}
